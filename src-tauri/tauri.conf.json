{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgilebotRobotToolbox",
  "version": "1.2.8",
  "identifier": "com.gbt.register.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agilebot robot toolbox",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "devtools": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/gbt-bridge"],
    "resources": [],
    "publisher": "Agilebot",
    "copyright": "Copyright 2026 Agilebot. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "Agilebot robot toolbox",
    "longDescription": "Agilebot robot toolbox for register import/export, batch creation, logs, program data export, and plugin installation.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      },
      "wix": {
        "upgradeCode": "4f91b368-4cc3-5e9b-a473-80c13c12ed34",
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
